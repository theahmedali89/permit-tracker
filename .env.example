# Permit Warden — environment variables (placeholders only; never put real secrets here)
# Copy to .env.local and fill in real values. .env* is git-ignored.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Cron (daily reminders) — must match the Authorization: Bearer value in Vercel Cron
CRON_SECRET=

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback

# Google Calendar token encryption — base64-encoded 32-byte key
# Generate with: openssl rand -base64 32
CALENDAR_TOKEN_KEY=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Platform admins — comma-separated emails allowed to manage the blog and
# jurisdiction regulations (also enforced via the platform_admins table)
PLATFORM_ADMIN_EMAILS=

# Google Analytics
NEXT_PUBLIC_GA_ID=
